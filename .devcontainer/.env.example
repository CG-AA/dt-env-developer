# Environment configuration for development container
# Copy this file to .env and modify as needed

# Set to 'true' to enable direnv automatic loading when container starts
ENABLE_DEVELOPMENT_MODE=false

# Docker buildkit (already set in docker-compose, but can be overridden here)
DOCKER_BUILDKIT=1

# ----- Headless Mode (Server/CLI) -----
# Set to 'true' when running without VS Code (e.g., on a server)
# HEADLESS_MODE=true

# ----- Optional: mkcert CA (for local HTTPS) -----
# macOS: ~/Library/Application Support/mkcert
# Linux: ~/.local/share/mkcert
# Leave empty to skip mkcert (recommended for headless servers)
# MKCERT_PATH=

